[Unit]
Description=Active-Edge fullscreen room-booking display
After=weston.service network-online.target
Requires=weston.service
Wants=network-online.target

[Service]
Type=simple
User=weston
Group=weston
Environment=XDG_RUNTIME_DIR=/run
Environment=WAYLAND_DISPLAY=wayland-0
Environment=HOME=/var/lib/active-edge-room-booking-display
Environment=XDG_DATA_HOME=/var/lib/active-edge-room-booking-display/data
Environment=XDG_CACHE_HOME=/var/lib/active-edge-room-booking-display/cache
Environment=XDG_CONFIG_HOME=/var/lib/active-edge-room-booking-display/config
Environment=SDL_TOUCH_MOUSE_EVENTS=1
Environment=SDL_MOUSE_TOUCH_EVENTS=0
Environment=AESL_ROOM_BOOKING_CALENDAR_PATH=/var/lib/active-edge-room-booking/calendar_day.json
ExecStart=/usr/bin/godot3 --main-pack /opt/active-edge-room-booking/active-edge-room-booking.pck --video-driver GLES2 --fullscreen
Restart=on-failure
RestartSec=2s
StateDirectory=active-edge-room-booking-display
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/active-edge-room-booking
ReadWritePaths=/var/lib/active-edge-room-booking-display

[Install]
WantedBy=graphical.target
